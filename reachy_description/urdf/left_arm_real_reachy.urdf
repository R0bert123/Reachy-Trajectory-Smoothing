<?xml version="1.0"?>
<robot name="left_arm">

  <!-- ================= BASE ================= -->
  <link name="base_link"/>

  <joint name="base_to_l_shoulder" type="fixed">
    <parent link="base_link"/>
    <child link="l_shoulder"/>
    <origin xyz="0.0 0.19 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ================= ARM ================= -->
  <link name="l_shoulder"/>
  <joint name="l_shoulder_pitch" type="revolute">
    <parent link="l_shoulder"/>
    <child link="l_shoulder_x"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <link name="l_shoulder_x"/>
  <joint name="l_shoulder_roll" type="revolute">
    <parent link="l_shoulder_x"/>
    <child link="l_upper_arm"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.174" upper="3.14" effort="10" velocity="1.5"/>
  </joint>

  <link name="l_upper_arm"/>
  <joint name="l_arm_yaw" type="revolute">
    <parent link="l_upper_arm"/>
    <child link="l_forearm"/>
    <origin xyz="0 0 -0.28" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <link name="l_forearm"/>
  <joint name="l_elbow_pitch" type="revolute">
    <parent link="l_forearm"/>
    <child link="l_wrist"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.182" upper="0.0" effort="10" velocity="1.5"/>
  </joint>

  <link name="l_wrist"/>
  <joint name="l_forearm_yaw" type="revolute">
    <parent link="l_wrist"/>
    <child link="l_wrist2hand"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.745" upper="1.745" effort="10" velocity="1.5"/>
  </joint>

  <link name="l_wrist2hand"/>
  <joint name="l_wrist_pitch" type="revolute">
    <parent link="l_wrist2hand"/>
    <child link="l_gripper"/>
    <origin xyz="0 0 -0.085" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785" upper="0.785" effort="10" velocity="1.5"/>
  </joint>

  <link name="l_gripper"/>
  <joint name="l_wrist_roll" type="revolute">
    <parent link="l_gripper"/>
    <child link="l_tool"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.61" upper="0.95" effort="10" velocity="1.5"/>
  </joint>

  <link name="l_tool"/>

</robot>

