      <command_interface name="d_gain"/>
    </joint>
    <sensor name="l_force_gripper">
      <state_interface name="force">
        <param name="initial_value">0.0</param>
      </state_interface>
    </sensor>
    <joint name="l_shoulder_fan">
      <state_interface name="state">
        <param name="initial_value">0.0</param>
      </state_interface>
      <command_interface name="state"/>
    </joint>
    <joint name="l_elbow_fan">
      <state_interface name="state">
        <param name="initial_value">0.0</param>
      </state_interface>
      <command_interface name="state"/>
    </joint>
    <joint name="l_wrist_fan">
      <state_interface name="state">
        <param name="initial_value">0.0</param>
      </state_interface>
      <command_interface name="state"/>
    </joint>
  </ros2_control>
</robot>
